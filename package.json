{
  "name": "forge",
  "version": "0.1.0",
  "description": "Per-repository progress tracker for AI orchestrators: tasks on a Gantt chart, stateful markdown tickets, a log, and a self-contained HTML dashboard regenerated on every command",
  "type": "module",
  "bin": {
    "forge": "agent-progress.ts"
  },
  "scripts": {
    "typecheck": "bun run --parallel typecheck:root typecheck:bridge typecheck:bridge-specs",
    "typecheck:root": "tsc -p tsconfig.json",
    "typecheck:bridge": "tsc -p bridge/tsconfig.json",
    "typecheck:bridge-specs": "tsc -p bridge/tsconfig.spec.json",
    "lint": "eslint . --concurrency auto",
    "lint:fix": "eslint . --concurrency auto --fix",
    "setup": "bun setup.ts",
    "test": "bun test",
    "verify": "bun run --parallel typecheck lint && bun test && bun src/testing/CheckRecordingStamps.ts && bun bridge/testing/RunDomSpecs.ts",
    "record": "bun src/testing/RecordBoundary.ts",
    "verify:integration": "bun test --path-ignore-patterns='.claude/**' .integration.spec.ts"
  },
  "private": true,
  "devDependencies": {
    "@happy-dom/global-registrator": "21.0.4",
    "@reliquary/eslint-config": "^1.0.1",
    "@testing-library/dom": "10.4.2",
    "@testing-library/react": "16.3.3",
    "@types/bun": "^1.3.14",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "eslint": "^9",
    "eslint-plugin-react-hooks": "7.1.1",
    "typescript": "6.0.3"
  },
  "dependencies": {
    "marked": "17.0.6",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  }
}

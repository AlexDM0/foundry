{
  "name": "gaia-workspace",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.4.2",
  "engines": { "bun": "1.4.2" },
  "workspaces": ["apps/*", "packages/*", "migration/*"],
  "scripts": {
    "typecheck": "bun run --filter '*' typecheck",
    "lint": "bun run --filter '*' lint",
    "verify": "bun run --filter '*' verify"
  },
  "devDependencies": {
    "@happy-dom/global-registrator": "21.0.4",
    "@reliquary/eslint-config": "1.0.1",
    "@storybook/react-vite": "10.6.7",
    "@testing-library/dom": "10.4.2",
    "@testing-library/react": "16.3.3",
    "@types/bun": "1.4.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.3.0",
    "eslint": "9.39.5",
    "eslint-plugin-react-hooks": "7.1.1",
    "storybook": "10.6.7",
    "typescript": "6.0.3",
    "vite": "8.3.8"
  }
}

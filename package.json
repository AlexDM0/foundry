{
  "name": "gaia",
  "version": "0.1.0",
  "description": "One window over every forge on a machine: what waits on User, every running agent, and every forge's state and controls",
  "type": "module",
  "private": true,
  "packageManager": "bun@1.4.2",
  "engines": { "bun": "1.4.2" },
  "bin": { "gaia": "src/Main.ts" },
  "scripts": {
    "typecheck": "tsc -p tsconfig.json && tsc -p page/tsconfig.json && tsc -p page/tsconfig.spec.json",
    "lint": "eslint . --cache --cache-strategy content --cache-location node_modules/.cache/lint/",
    "lint:fix": "eslint . --cache --cache-strategy content --cache-location node_modules/.cache/lint/ --fix",
    "test": "bun test",
    "verify": "bun run typecheck && bun run lint && bun test"
  },
  "dependencies": {
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@reliquary/eslint-config": "1.0.1",
    "@types/bun": "1.4.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "eslint": "9.39.5",
    "eslint-plugin-react-hooks": "7.1.1",
    "typescript": "6.0.3"
  }
}

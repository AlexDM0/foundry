 .design-system-state-badge[data-pulsing] .design-system-state-badge-dot { animation: design-system-pulse var(--pulse-status) ease-in-out infinite; }
 .design-system-state-badge-label { overflow: hidden; text-overflow: ellipsis; }
 .design-system-state-badge[data-struck] .design-system-state-badge-label { text-decoration: line-through; }

-/* A state's dot in its shape: a solid dot, a ring or a dashed ring; 8px, small 7px, tiny 6px. */
+/* A state's dot in its shape: a solid dot, a ring, a dashed ring or a diamond; 8px, small 7px, tiny 6px. */
 .design-system-state-dot {
   flex: none;
   box-sizing: border-box;
@@ -14,3 +14,5 @@
 .design-system-state-dot[data-state-tone] { background: var(--s-fill); }
 .design-system-state-dot[data-shape="dashed-ring"] { background: transparent; border: 1.5px dashed var(--s-fill); }
 .design-system-state-dot[data-shape="ring"] { background: transparent; border: 1.5px solid var(--s-fill); }
+/* A diamond is the ring's square turned 45 degrees and drawn at 85%, so its corners reach about as far as a round dot's edge. */
+.design-system-state-dot[data-shape="diamond"] { background: transparent; border: 1.5px solid var(--s-fill); border-radius: 0; transform: rotate(45deg) scale(0.85); }

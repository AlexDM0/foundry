diff --git a/atoms/Button.dom.tsx b/atoms/Button.dom.tsx
index a4e798c54bf6f2e8f0d0a325dcb12a49e060d901..be83ae2bcf9c77d7fff98cd4e07ecfd478ec506b 100644
--- a/atoms/Button.dom.tsx
+++ b/atoms/Button.dom.tsx
@@ -1,8 +1,8 @@
 /**
  * The button, in a happy-dom document. What matters: a quiet button calls `onPress` and a disabled one does not; each emphasis, the
  * attention ring, the link tint and the compact and dense heights is a `data-*` attribute on the one class; with an `href` the button is a
- * link and no button; a toggle and a disclosure carry their aria state; the leading glyph comes before the label; and a label is text,
- * never markup.
+ * link and no button; a toggle and a disclosure carry their aria state; the leading glyph comes before the label and the trailing glyph
+ * after it, on a button and on a link; and a label is text, never markup.
  */
 import {
   cleanup,
@@ -109,6 +109,20 @@ describe('the button', () => {
     expect([button.firstElementChild?.hasAttribute('data-leading'), button.textContent]).toEqual([true, '+New chat']);
   });
 
+  test('the trailing glyph shows after the label, on a button and on a link drawn as one', () => {
+    render(
+      <>
+        <Button label="Stop" leading={<span data-leading="">+</span>} trailing={<span data-trailing="">v</span>} />
+        <Button label="Open the example" href="#example" trailing={<span data-trailing="">^</span>} />
+      </>,
+    );
+    const button = screen.getByRole('button');
+    const link = screen.getByRole('link');
+    expect([button.firstElementChild?.hasAttribute('data-leading'), button.lastElementChild?.hasAttribute('data-trailing'), button.textContent])
+      .toEqual([true, true, '+Stopv']);
+    expect([link.lastElementChild?.hasAttribute('data-trailing'), link.textContent]).toEqual([true, 'Open the example^']);
+  });
+
   test('a label is text, never markup', () => {
     render(<Button label="<b>planted</b>" />);
     const button = screen.getByRole('button');

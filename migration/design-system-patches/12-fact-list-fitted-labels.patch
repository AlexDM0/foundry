diff --git a/molecules/FactList.css b/molecules/FactList.css
index a9db8f1050358df8a3623b820d4cac0ea1b09217..b7e58aa4e3f202d168aff4afd4a42e15b08ede29 100644
--- a/molecules/FactList.css
+++ b/molecules/FactList.css
@@ -24,3 +24,6 @@
 .design-system-facts[data-layout="table"] { display: flex; flex-direction: column; gap: var(--space-4); padding-top: var(--space-6); border-top: 1px dashed var(--line); font-size: var(--fs-small); }
 .design-system-facts[data-layout="table"] .design-system-fact { display: grid; grid-template-columns: 62px minmax(0, 1fr); gap: var(--sp-2); }
 .design-system-facts[data-layout="table"] dt { color: var(--ink-muted); }
+/* Fitted labels share one column, as wide as the widest label, so no label wraps. */
+.design-system-facts[data-layout="table"][data-fitted-labels] { display: grid; grid-template-columns: max-content minmax(0, 1fr); gap: var(--space-4) var(--sp-2); }
+.design-system-facts[data-layout="table"][data-fitted-labels] .design-system-fact { display: contents; }

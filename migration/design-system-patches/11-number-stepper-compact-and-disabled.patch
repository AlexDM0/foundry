From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: AlexDM0 <alexdemulder@gmail.com>
Date: Sun, 15 Nov 2026 10:35:49 +0100
Subject: NumberStepper: a disabled state and a compact form with a leading
 text

---
 atoms/NumberStepper.css         | 10 ++++++++
 atoms/NumberStepper.dom.tsx     | 43 ++++++++++++++++++++++++++++++++-
 atoms/NumberStepper.stories.tsx |  2 ++
 atoms/NumberStepper.tsx         | 22 ++++++++++++-----
 4 files changed, 70 insertions(+), 7 deletions(-)

diff --git a/atoms/NumberStepper.css b/atoms/NumberStepper.css
index 5d2537ea50ffd40a5c0de213b38ad99d74b120a1..19eb5fe6d98f72b63e28615d16c68f708e62b6b7 100644
--- a/atoms/NumberStepper.css
+++ b/atoms/NumberStepper.css
@@ -13,3 +13,13 @@
   color: var(--ink); font-weight: 600; font-variant-numeric: tabular-nums;
   background: var(--bg); border-inline: 1px solid var(--line);
 }
+
+/* A compact stepper: two 24px buttons, each in its own box, around the value as mono text on no ground. */
+.design-system-number-stepper[data-compact] { align-items: center; gap: var(--sp-1); overflow: visible; border: 0; border-radius: 0; }
+.design-system-number-stepper[data-compact] > button {
+  width: 24px; height: 24px; font: 500 14px/1 var(--font-ui); border: 1px solid var(--line-strong); border-radius: var(--r-2);
+}
+.design-system-number-stepper[data-compact] > button:disabled { color: var(--ink-disabled); border-color: var(--line); }
+.design-system-number-stepper[data-compact] > .design-system-number-stepper-value {
+  width: auto; min-width: 40px; height: auto; font: 400 var(--fs-tab)/1 var(--font-mono); background: transparent; border: 0;
+}
diff --git a/atoms/NumberStepper.dom.tsx b/atoms/NumberStepper.dom.tsx
index bfb54b26dffa6718057d269da24d1ef75bc76f83..accb2959d3c9652babd71eb838e8a0ffae5257fc 100644
--- a/atoms/NumberStepper.dom.tsx
+++ b/atoms/NumberStepper.dom.tsx
@@ -1,7 +1,8 @@
 /**
  * The number stepper, in a happy-dom document. What matters: the buttons and ArrowUp and ArrowDown on the group step the value by `step`;
  * a change is clamped at the minimum and the maximum, and a button that cannot step is disabled, a step that disables the focused button
- * handing the focus to the other one; the group is named, and the value is read with its unit.
+ * handing the focus to the other one; a disabled stepper steps on nothing; the group is named, and the value is read with its unit and its
+ * leading text; compact sets `data-compact`.
  */
 import {
   cleanup,
@@ -109,4 +110,44 @@ describe('the number stepper', () => {
     const value = group.querySelector('.design-system-number-stepper-value');
     expect([value?.textContent, value?.getAttribute('aria-label')]).toEqual(['750', '750 lines']);
   });
+
+  test('a disabled stepper disables both buttons and steps on no key', () => {
+    const changes: number[] = [];
+    render(
+      <NumberStepper
+        accessibleName="Example limit"
+        value={4}
+        step={1}
+        minimum={1}
+        maximum={8}
+        unitText="seats"
+        lowerLabel="Lower the example limit"
+        raiseLabel="Raise the example limit"
+        disabled
+        onChange={(changed) => changes.push(changed)}
+      />,
+    );
+    fireEvent.keyDown(screen.getByRole('group', { name: 'Example limit' }), { key: 'ArrowUp' });
+    expect([isDisabled('Lower the example limit'), isDisabled('Raise the example limit'), changes]).toEqual([true, true, []]);
+  });
+
+  test('a compact stepper sets data-compact, and its leading text shows before the value and is read with it', () => {
+    render(
+      <NumberStepper
+        accessibleName="Example limit"
+        value={5}
+        step={1}
+        minimum={1}
+        unitText="seats"
+        lowerLabel="Lower the example limit"
+        raiseLabel="Raise the example limit"
+        compact
+        leadingText="4 /"
+        onChange={() => undefined}
+      />,
+    );
+    const group = screen.getByRole('group', { name: 'Example limit' });
+    const value = group.querySelector('output');
+    expect([group.hasAttribute('data-compact'), value?.textContent, value?.getAttribute('aria-label')]).toEqual([true, '4 / 5', '4 / 5 seats']);
+  });
 });

diff --git a/molecules/ConfirmStrip.css b/molecules/ConfirmStrip.css
index b05d0bca26fc24d300055120dd2a2cb9caa0e38f..fa1c3436d78f84e79b692dc6b661d65f24ff06f6 100644
--- a/molecules/ConfirmStrip.css
+++ b/molecules/ConfirmStrip.css
@@ -11,5 +11,8 @@
 /* An action confirmed in place: the neutral strip reads as one line of text before its actions. */
 .design-system-confirm-text { min-width: 0; }
 .design-system-confirm-actions { display: inline-flex; flex-wrap: wrap; align-items: center; gap: var(--sp-2); }
+/* With choices, the strip stacks its question, its choices side by side in equal columns, and its actions. */
+.design-system-confirm[data-with-choices] { display: flex; flex-direction: column; align-items: stretch; gap: var(--sp-3); }
+.design-system-confirm-choices { display: grid; grid-auto-columns: minmax(0, 1fr); grid-auto-flow: column; gap: var(--sp-3); }
 .design-system-confirm[data-tone="danger"] .design-system-confirm-question { font-weight: 600; }
 .design-system-confirm[data-tone="danger"] .design-system-confirm-consequence { display: block; margin: var(--space-2) 0 var(--sp-2); }
diff --git a/molecules/ConfirmStrip.dom.tsx b/molecules/ConfirmStrip.dom.tsx
index 7774bac47279bcc1963c80c341888c635771f6bd..ee2ca7789ba9f13d5cd6a8c034825b98ebd807c6 100644
--- a/molecules/ConfirmStrip.dom.tsx

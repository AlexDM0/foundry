From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: AlexDM0 <alexdemulder@gmail.com>
Date: Sun, 15 Nov 2026 10:32:32 +0100
Subject: IconButton: a disabled state

---
 atoms/IconButton.css         |  7 ++++---
 atoms/IconButton.dom.tsx     | 10 +++++++++-
 atoms/IconButton.stories.tsx |  1 +
 atoms/IconButton.tsx         | 10 +++++++---
 4 files changed, 21 insertions(+), 7 deletions(-)

diff --git a/atoms/IconButton.css b/atoms/IconButton.css
index b31f7dadcded42a5c923e9151bac8899ee005372..8643952a9b2f2a755d82433fe13bfc038270bbf2 100644
--- a/atoms/IconButton.css
+++ b/atoms/IconButton.css
@@ -7,10 +7,11 @@
   cursor: pointer;
   transition: var(--feedback-transition), transform var(--motion-fast) var(--ease-out);
 }
-.design-system-icon-button:hover { filter: brightness(0.94); border-color: var(--line-strong); }
-.design-system-icon-button:active { transform: scale(var(--press-scale)); }
+.design-system-icon-button:not(:disabled):hover { filter: brightness(0.94); border-color: var(--line-strong); }
+.design-system-icon-button:not(:disabled):active { transform: scale(var(--press-scale)); }
 .design-system-icon-button:focus-visible { outline: 2px solid var(--link); outline-offset: 2px; }
+.design-system-icon-button:disabled { color: var(--ink-disabled); cursor: not-allowed; }
 
 @media (prefers-reduced-motion: reduce) {
-  .design-system-icon-button:active { transform: none; }
+  .design-system-icon-button:not(:disabled):active { transform: none; }
 }
diff --git a/atoms/IconButton.dom.tsx b/atoms/IconButton.dom.tsx
index b9a2da27a93156a8258ed38ebf497d443afb6090..ba61cddd0ac6efa07820031d9f25a3cf8c044c3b 100644
--- a/atoms/IconButton.dom.tsx
+++ b/atoms/IconButton.dom.tsx
@@ -1,6 +1,6 @@
 /**
  * The icon button, in a happy-dom document. What matters: it shows its glyph or the caller's drawing, hidden from the accessibility tree,
- * under its accessible name, carries its title, and calls `onPress`.
+ * under its accessible name, carries its title, and calls `onPress`, unless it is disabled.
  */
 import {
   cleanup,
@@ -41,4 +41,12 @@ describe('the icon button', () => {
     expect([button.getAttribute('title'), button.firstElementChild?.getAttribute('aria-hidden'), button.querySelector('[data-example-drawing]') !== null])
       .toEqual(['Example theme', 'true', true]);
   });
+
+  test('a disabled icon button is disabled and does not call onPress', () => {
+    const presses: string[] = [];
+    render(<IconButton glyph="close" accessibleName="Close the example panel" disabled onPress={() => presses.push('pressed')} />);
+    const button = screen.getByRole('button', { name: 'Close the example panel' });
+    fireEvent.click(button);
+    expect([button.hasAttribute('disabled'), presses]).toEqual([true, []]);
+  });
 });
diff --git a/atoms/IconButton.stories.tsx b/atoms/IconButton.stories.tsx
index 4b9e8015f71ab97e15e5da6edd8b3b9833af77ff..7ad7a0121412ab330f3733f4044180ed3c2a9262 100644
--- a/atoms/IconButton.stories.tsx
+++ b/atoms/IconButton.stories.tsx
@@ -15,4 +15,5 @@ export default meta;
 type Story = StoryObj<typeof meta>;
 
 export const Glyph: Story = {};
+export const Disabled: Story = { args: { disabled: true } };
 export const Drawing: Story = { render: () => <IconButton drawing={<Icon name="dot" label={null} />} accessibleName="Example drawing" title="Example drawing" onPress={fn()} />, };
diff --git a/atoms/IconButton.tsx b/atoms/IconButton.tsx
index 07b174adc63c14c4a0fc1f47603f98b553989617..fe992a96cd02e1b58f78c935a7c8bc1e9308748a 100644
--- a/atoms/IconButton.tsx
+++ b/atoms/IconButton.tsx
@@ -1,4 +1,7 @@
-/** The square icon button: it shows a package glyph or a drawing of the caller's, hidden from the accessibility tree, under its name. */
+/**
+ * The square icon button: it shows a package glyph or a drawing of the caller's, hidden from the accessibility tree, under its name. A
+ * disabled one is drawn faded and calls nothing.
+ */
 import type { ReactNode, Ref } from 'react';
 
 export type IconGlyph = 'close';
@@ -13,14 +16,15 @@ export type IconButtonProps = IconButtonDrawing & {
   /** The tooltip the pointer shows. */
   readonly title?:         string;
   readonly onPress:        () => void;
+  readonly disabled?:      boolean;
   readonly buttonRef?:     Ref<HTMLButtonElement>;
 };
 
 export function IconButton({
-  glyph, drawing, accessibleName, title, onPress, buttonRef
+  glyph, drawing, accessibleName, title, onPress, disabled = false, buttonRef
 }: IconButtonProps) {
   return (
-    <button ref={buttonRef} type="button" className="design-system-icon-button" aria-label={accessibleName} title={title} onClick={onPress}>
+    <button ref={buttonRef} type="button" className="design-system-icon-button" aria-label={accessibleName} title={title} disabled={disabled} onClick={onPress}>
       <span aria-hidden="true">{glyph === undefined ? drawing : GLYPH_TEXT[glyph]}</span>
     </button>
   );

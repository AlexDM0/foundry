Subject: Button and IconButton: the press scale as a token

---
 README.md            | 2 ++
 atoms/Button.css     | 2 +-
 atoms/IconButton.css | 2 +-
 styles/tokens.css    | 2 ++
 4 files changed, 6 insertions(+), 2 deletions(-)

diff --git a/README.md b/README.md
index a82816db9306139013d10acc5faeb8087449f29c..29638068fa1f4c23ad99c41bccfed66d371e1da7 100644
--- a/README.md
+++ b/README.md
@@ -83,6 +83,8 @@ change its look. The element is your choice, never the role's: pass `element="h2
   the first paint.
 - Every motion token is `0ms` until you set `data-motion="ready"` on the `html` element. Set it after the first paint,
   so the first render shows its final state at once. Under `prefers-reduced-motion: reduce` every animation stops.
+- A pressed `Button` or `IconButton` shrinks to `--press-scale` (0.98). Set `--press-scale: 1` on the `html` element for
+  a press that changes no size.
 - Every colour, space, radius, type size, shadow and time is a custom property of `styles/tokens.css`. Your own
   stylesheets can read them too.
 - An element with `data-state-tone` set to a `StateTone` reads its colours from that tone's row: `--s-fill`,
diff --git a/atoms/Button.css b/atoms/Button.css
index 4eccb2babddf65c3154d65b9c21f6278f966f76d..fe8c24d467aa70a679616d0dbcf8a7002b7af193 100644
--- a/atoms/Button.css
+++ b/atoms/Button.css
@@ -12,7 +12,7 @@
   transition: var(--feedback-transition), transform var(--motion-fast) var(--ease-out);
 }
 .design-system-button:not(:disabled):hover { filter: brightness(0.94); }
-.design-system-button:not(:disabled):active { transform: scale(0.98); }
+.design-system-button:not(:disabled):active { transform: scale(var(--press-scale)); }
 .design-system-button:focus-visible { outline: 2px solid var(--link); outline-offset: 2px; }
 .design-system-button[data-compact] { height: 30px; padding: 0 var(--space-11); font-size: var(--fs-tab); }
 .design-system-button[data-dense] { height: 26px; padding: 0 var(--space-9); font-size: var(--fs-tab); }
diff --git a/atoms/IconButton.css b/atoms/IconButton.css
index 123f7a75a7d6e54c4dbbd8f84444420abe5f5a54..b31f7dadcded42a5c923e9151bac8899ee005372 100644
--- a/atoms/IconButton.css
+++ b/atoms/IconButton.css
@@ -8,7 +8,7 @@
   transition: var(--feedback-transition), transform var(--motion-fast) var(--ease-out);
 }
 .design-system-icon-button:hover { filter: brightness(0.94); border-color: var(--line-strong); }
-.design-system-icon-button:active { transform: scale(0.98); }
+.design-system-icon-button:active { transform: scale(var(--press-scale)); }
 .design-system-icon-button:focus-visible { outline: 2px solid var(--link); outline-offset: 2px; }
 
 @media (prefers-reduced-motion: reduce) {
diff --git a/styles/tokens.css b/styles/tokens.css
index 11538e9d045b3e1b5051e494b4128e4033682a1b..1571fde5a0738d29cdb15f3ba18cbdb98bd426ff 100644
--- a/styles/tokens.css
+++ b/styles/tokens.css
@@ -48,6 +48,8 @@
   --rise-step:        80ms;
   --glow-period:      2.6s;
   --toast-duration:   5s;
+  /* The scale a pressed button or icon button shrinks to; a host sets 1 for a press that keeps every size. */
+  --press-scale:      0.98;
 
   /* The graphite light theme: pure neutral greys with no tint, and one orange family. */
   --bg:           #f6f6f6;

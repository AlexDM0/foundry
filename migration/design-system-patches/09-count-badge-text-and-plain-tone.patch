From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: AlexDM0 <alexdemulder@gmail.com>
Date: Sun, 15 Nov 2026 10:33:51 +0100
Subject: CountBadge: a count written as text and a plain tone

---
 atoms/CountBadge.css         |  5 +++--
 atoms/CountBadge.dom.tsx     | 19 ++++++++++++++++---
 atoms/CountBadge.stories.tsx |  2 ++
 atoms/CountBadge.tsx         |  9 +++++----
 4 files changed, 26 insertions(+), 9 deletions(-)

diff --git a/atoms/CountBadge.css b/atoms/CountBadge.css
index 0b54bcbcb4ab3ebce41d694dfbe5de4dd9075e88..cc953343920495d218e91cc383b52924542e45f2 100644
--- a/atoms/CountBadge.css
+++ b/atoms/CountBadge.css
@@ -1,5 +1,5 @@
-/* A count after a label, in a small mono pill: quiet on the wash, a state's colours, orange for a warning or the failure colours; marked
-   leads with a dot. It is never filled orange. */
+/* A count after a label, in a small mono pill: quiet on the wash, plain on no ground, a state's colours, orange for a warning or the
+   failure colours; marked leads with a dot. It is never filled orange. */
 .design-system-count-badge {
   display: inline-flex; align-items: center; gap: var(--space-4);
   margin-left: var(--space-6); padding: var(--space-1) var(--space-6);
@@ -8,6 +8,7 @@
   color: var(--ink-muted); background: var(--wash);
   border: 1px solid transparent; border-radius: var(--r-pill);
 }
+.design-system-count-badge[data-tone="plain"] { background: transparent; }
 .design-system-count-badge[data-tone="state"] { color: var(--s-ink); background: var(--s-tint); border-color: var(--s-edge); }
 .design-system-count-badge[data-tone="warn"] { font-weight: 600; color: var(--link); background: var(--link-tint); }
 .design-system-count-badge[data-tone="error"] { font-weight: 600; color: var(--err-ink); background: var(--err-tint); }
diff --git a/atoms/CountBadge.dom.tsx b/atoms/CountBadge.dom.tsx
index 63461080a0fadfd735506ed75d5610127f000b3d..7ae043e3f2940246744af36e9eb6fe909815032c 100644
--- a/atoms/CountBadge.dom.tsx
+++ b/atoms/CountBadge.dom.tsx
@@ -1,6 +1,6 @@
 /**
- * The count badge, in a happy-dom document. What matters: it shows the count; each tone sets `data-tone`; a state tone shows only with the
- * `state` tone; a marked count leads with a dot hidden from the accessibility tree.
+ * The count badge, in a happy-dom document. What matters: it shows the count, a number or a count written as text; each tone sets
+ * `data-tone`; a state tone shows only with the `state` tone; a marked count leads with a dot hidden from the accessibility tree.
  */
 import { cleanup, render } from '@testing-library/react';
 import {
@@ -24,11 +24,24 @@ describe('the count badge', () => {
         <CountBadge count={1} tone="error" />
         <CountBadge count={0} tone="neutral" />
         <CountBadge count={2} tone="warn" />
+        <CountBadge count={5} tone="plain" />
       </>,
     );
     expect([...container.querySelectorAll('.design-system-count-badge')]
       .map((badge) => [badge.textContent, badge.getAttribute('data-tone'), badge.getAttribute('data-state-tone')]))
-      .toEqual([['3', 'state', 'accent-outline'], ['1', 'error', null], ['0', 'neutral', null], ['2', 'warn', null]]);
+      .toEqual([['3', 'state', 'accent-outline'], ['1', 'error', null], ['0', 'neutral', null], ['2', 'warn', null], ['5', 'plain', null]]);
+  });
+
+  test('a count written as text shows as written, and is text, never markup', () => {
+    const { container } = render(
+      <>
+        <CountBadge count="4+" tone="plain" />
+        <CountBadge count="2?" tone="neutral" />
+        <CountBadge count="<b>planted</b>" tone="neutral" />
+      </>,
+    );
+    expect([...container.querySelectorAll('.design-system-count-badge')].map((badge) => badge.textContent)).toEqual(['4+', '2?', '<b>planted</b>']);
+    expect(container.querySelector('b')).toBeNull();
   });
 
   test('a marked count leads with a dot hidden from the accessibility tree, and an unmarked one has none', () => {
diff --git a/atoms/CountBadge.stories.tsx b/atoms/CountBadge.stories.tsx
index 5e420f27ac89bc9f9119e201c89d923f653e378f..e49d9db29d6c029a86b7f67ee785211c35c7001e 100644
--- a/atoms/CountBadge.stories.tsx
+++ b/atoms/CountBadge.stories.tsx
@@ -13,6 +13,8 @@ export default meta;
 type Story = StoryObj<typeof meta>;
 
 export const Neutral: Story = {};
+export const Plain: Story = { args: { tone: 'plain' } };
+export const CountAsText: Story = { args: { count: '4+' } };
 export const State: Story = { args: { tone: 'state', stateTone: 'accent' } };
 export const Warn: Story = { args: { tone: 'warn' } };
 export const ErrorTone: Story = { args: { tone: 'error' } };
diff --git a/atoms/CountBadge.tsx b/atoms/CountBadge.tsx
index a3b730a31a4736c256da1e1bbbac6dcd0e36a0c7..ebe4f8015f160f7616bebde963d4ca6ac7c386b7 100644
--- a/atoms/CountBadge.tsx
+++ b/atoms/CountBadge.tsx
@@ -1,10 +1,10 @@
 /**
- * A count in a small mono pill after a label, such as a tab's: neutral, in a state tone's colours, or in the warn or error colours; a
- * marked count leads with a dot, hidden from the accessibility tree, where its colour alone says something is urgent.
+ * A count in a small mono pill after a label, such as a tab's: neutral, plain with no ground, in a state tone's colours, or in the warn or
+ * error colours; a marked count leads with a dot, hidden from the accessibility tree, where its colour alone says something is urgent.
  */
 import type { StateTone } from '../@types/StateTone.ts';
 
-export type CountBadgeTone = 'neutral' | 'state' | 'warn' | 'error';
+export type CountBadgeTone = 'neutral' | 'plain' | 'state' | 'warn' | 'error';
 
 /** A `state` count takes the colours of its state tone; every other tone has colours of its own, so it takes none. */
 export type CountBadgeColours =
@@ -12,7 +12,8 @@ export type CountBadgeColours =
   | { readonly tone: Exclude<CountBadgeTone, 'state'>; readonly stateTone?: never };
 
 export type CountBadgeProps = CountBadgeColours & {
-  readonly count:   number;
+  /** A number, or a count written as text, such as "4+" or "2?". */
+  readonly count:   number | string;
   readonly marked?: boolean;
 };
 

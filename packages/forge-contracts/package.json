{
  "name": "forge-contracts",
  "version": "0.2.0",
  "description": "The documents a forge's Overseer serves and reads, as types, with the forge system versions and each endpoint's version: produced by forge, read by Gaia",
  "type": "module",
  "engines": { "bun": "1.4.2" },
  "files": ["@types", "constants/OverseerContractVersions.ts", "constants/ForgeSystemVersions.ts", "README.md", "FORGE_REQUIREMENTS.md"],
  "exports": {
    "./VersionsDocument": "./@types/VersionsDocument.ts",
    "./IdentityDocument": "./@types/IdentityDocument.ts",
    "./BoardSummaryDocument": "./@types/BoardSummaryDocument.ts",
    "./MonitorSnapshotDocument": "./@types/MonitorSnapshotDocument.ts",
    "./ForgeControlCommand": "./@types/ForgeControlCommand.ts",
    "./EmbedChannelMessage": "./@types/EmbedChannelMessage.ts",
    "./OverseerContractVersions": "./constants/OverseerContractVersions.ts",
    "./ForgeSystemVersions": "./constants/ForgeSystemVersions.ts"
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.json",
    "lint": "eslint . --cache --cache-strategy content --cache-location node_modules/.cache/lint/",
    "test": "bun test",
    "verify": "bun run typecheck && bun run lint && bun test"
  }
}

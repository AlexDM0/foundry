{
  "name": "forge-contracts",
  "version": "4.1.0",
  "description": "What a forge serves and reads, as types: its documents, its commands, its system versions and its compatibility registry",
  "type": "module",
  "engines": { "bun": "1.4.2" },
  "files": ["@types", "constants/*.ts", "!constants/*.spec.ts", "scripts", "README.md"],
  "exports": {
    "./IdentityDocument": "./@types/IdentityDocument.ts",
    "./BoardSummaryDocument": "./@types/BoardSummaryDocument.ts",
    "./MonitorSnapshotDocument": "./@types/MonitorSnapshotDocument.ts",
    "./MonitorInterruptionCauses": "./constants/MonitorInterruptionCauses.ts",
    "./ForgeControlCommand": "./@types/ForgeControlCommand.ts",
    "./ForgeControlCommandKinds": "./constants/ForgeControlCommandKinds.ts",
    "./BoardCommand": "./@types/BoardCommand.ts",
    "./BoardStreamHandshake": "./@types/BoardStreamHandshake.ts",
    "./ForgePresenceDocument": "./@types/ForgePresenceDocument.ts",
    "./ForgeCrashLogDocument": "./@types/ForgeCrashLogDocument.ts",
    "./ForgeRefusalDocument": "./@types/ForgeRefusalDocument.ts",
    "./HephaestusContractVersions": "./constants/HephaestusContractVersions.ts",
    "./ForgeSystemVersions": "./constants/ForgeSystemVersions.ts",
    "./ForgeCompatibilityRegistry": "./constants/ForgeCompatibilityRegistry.ts",
    "./BoardVocabulary": "./constants/BoardVocabulary.ts",
    "./ForgeBoardDocument": "./@types/ForgeBoardDocument.ts",
    "./BoardPageDocuments": "./@types/BoardPageDocuments.ts",
    "./BoardJobDocuments": "./@types/BoardJobDocuments.ts",
    "./BoardConversationDocuments": "./@types/BoardConversationDocuments.ts",
    "./BoardPipelineDocuments": "./@types/BoardPipelineDocuments.ts",
    "./BoardMergeQueueDocument": "./@types/BoardMergeQueueDocument.ts",
    "./BoardLimitsDocument": "./@types/BoardLimitsDocument.ts",
    "./BoardReadingDocuments": "./@types/BoardReadingDocuments.ts",
    "./TicketDocumentsDocument": "./@types/TicketDocumentsDocument.ts"
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.json",
    "lint": "eslint . --cache --cache-strategy content --cache-location node_modules/.cache/lint/",
    "lint:fix": "eslint . --cache --cache-strategy content --cache-location node_modules/.cache/lint/ --fix",
    "test": "bun test",
    "versions:raise-minimum": "bun scripts/RaiseMinimum.ts",
    "verify": "bun run typecheck && bun run lint && bun test"
  },
  "dependencies": {
    "system-versions": "workspace:^"
  }
}

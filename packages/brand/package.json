{
  "name": "brand",
  "version": "0.2.0",
  "description": "Forge's mark as a React component, its colour tokens in a light and a dark theme, and the geometry a mark drawn alike shares",
  "type": "module",
  "engines": { "bun": "1.4.2" },
  "exports": {
    "./ForgeMark": "./marks/ForgeMark.tsx",
    "./MarkGeometry": "./constants/MarkGeometry.ts",
    "./brand.css": "./styles/brand.css"
  },
  "files": ["marks/*.tsx", "marks/*.css", "!marks/*.dom.tsx", "!marks/*.stories.tsx", "constants", "styles", "README.md"],
  "scripts": {
    "typecheck": "tsc -p tsconfig.json && tsc -p tsconfig.spec.json",
    "lint": "eslint . --cache --cache-strategy content --cache-location node_modules/.cache/lint/",
    "test": "bun test",
    "test:dom": "bun test --isolate --preload ./testing/HappyDomPreload.ts ./marks/*.dom.tsx",
    "verify": "bun run typecheck && bun run lint && bun run test && bun run test:dom"
  },
  "peerDependencies": {
    "react": ">=19"
  },
  "devDependencies": {
    "react": "19.3.1",
    "react-dom": "19.3.1"
  }
}

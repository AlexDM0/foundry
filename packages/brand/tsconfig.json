{
  // The package's own project, standing alone so the folder moves unchanged: DOM library, React's JSX and no Bun or Node types, so a mark
  // reaching for `Bun.file` or `node:fs` fails to compile.
  "compilerOptions": {
    "noEmit": true,
    "incremental": true,
    "tsBuildInfoFile": "./node_modules/.cache/typecheck/brand.tsbuildinfo",
    "target": "ESNext",
    "lib": ["ESNext", "DOM", "DOM.Iterable"],
    "module": "Preserve",
    "moduleResolution": "bundler",
    "moduleDetection": "force",
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "jsx": "react-jsx",
    "types": [],

    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "noFallthroughCasesInSwitch": true,
    "noPropertyAccessFromIndexSignature": true,
    "exactOptionalPropertyTypes": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "forceConsistentCasingInFileNames": true,

    "skipLibCheck": true
  },
  "include": ["./**/*.ts", "./**/*.tsx"],
  // The specs, the DOM specs, the stories and the test-only helpers stay out, so this program's surface is the package that ships.
  "exclude": ["./node_modules/**", "./**/*.spec.ts", "./**/*.dom.tsx", "./**/*.stories.tsx", "./testing/**"]
}

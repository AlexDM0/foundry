{
  "name": "design-system",
  "version": "0.2.0",
  "description": "A themed React component library built by composition: atoms, molecules and organisms, with its tokens, fonts and stylesheets",
  "type": "module",
  "scripts": {
    "typecheck": "tsc -p tsconfig.json && tsc -p tsconfig.spec.json",
    "lint": "eslint . --cache --cache-strategy content --cache-location node_modules/.cache/lint/",
    "lint:fix": "eslint . --cache --cache-strategy content --cache-location node_modules/.cache/lint/ --fix",
    "test": "bun test",
    "test:dom": "bun testing/RunDomSpecs.ts",
    "storybook": "storybook dev --port 6006 --config-dir .storybook",
    "storybook:build": "storybook build --config-dir .storybook --output-dir storybook-static"
  },
  "exports": {
    "./StateTone": "./@types/StateTone.ts",
    "./ThemeChoice": "./@types/ThemeChoice.ts",
    "./BusyIndicator": "./atoms/BusyIndicator.tsx",
    "./Button": "./atoms/Button.tsx",
    "./Checkbox": "./atoms/Checkbox.tsx",
    "./CountBadge": "./atoms/CountBadge.tsx",
    "./EmptyState": "./atoms/EmptyState.tsx",
    "./Figure": "./atoms/Figure.tsx",
    "./FlintSlot": "./atoms/FlintSlot.tsx",
    "./Icon": "./atoms/Icon.tsx",
    "./IconButton": "./atoms/IconButton.tsx",
    "./IdLink": "./atoms/IdLink.tsx",
    "./MicroCapsLabel": "./atoms/MicroCapsLabel.tsx",
    "./MonoId": "./atoms/MonoId.tsx",
    "./NumberStepper": "./atoms/NumberStepper.tsx",
    "./Popover": "./atoms/Popover.tsx",
    "./Skeleton": "./atoms/Skeleton.tsx",
    "./Stamp": "./atoms/Stamp.tsx",
    "./StateBadge": "./atoms/StateBadge.tsx",
    "./StateDot": "./atoms/StateDot.tsx",
    "./StatePill": "./atoms/StatePill.tsx",
    "./Switch": "./atoms/Switch.tsx",
    "./Text": "./atoms/Text.tsx",
    "./TextButton": "./atoms/TextButton.tsx",
    "./TextField": "./atoms/TextField.tsx",
    "./Tooltip": "./atoms/Tooltip.tsx",
    "./TypingIndicator": "./atoms/TypingIndicator.tsx",
    "./View": "./atoms/View.tsx",
    "./ActivityRow": "./molecules/ActivityRow.tsx",
    "./Banner": "./molecules/Banner.tsx",
    "./Callout": "./molecules/Callout.tsx",
    "./Card": "./molecules/Card.tsx",
    "./ChangeRow": "./molecules/ChangeRow.tsx",
    "./ChoiceOption": "./molecules/ChoiceOption.tsx",
    "./ConfirmStrip": "./molecules/ConfirmStrip.tsx",
    "./FactList": "./molecules/FactList.tsx",
    "./FailedAction": "./molecules/FailedAction.tsx",
    "./FillMeter": "./molecules/FillMeter.tsx",
    "./KeyedLineList": "./molecules/KeyedLineList.tsx",
    "./ListedFile": "./molecules/ListedFile.tsx",
    "./LogTail": "./molecules/LogTail.tsx",
    "./Menu": "./molecules/Menu.tsx",
    "./ModelEffortMeter": "./molecules/ModelEffortMeter.tsx",
    "./PageHead": "./molecules/PageHead.tsx",
    "./PendingStep": "./molecules/PendingStep.tsx",
    "./Row": "./molecules/Row.tsx",
    "./SectionHead": "./molecules/SectionHead.tsx",
    "./SegmentedControl": "./molecules/SegmentedControl.tsx",
    "./SegmentMeter": "./molecules/SegmentMeter.tsx",
    "./SlotMeter": "./molecules/SlotMeter.tsx",
    "./Stepper": "./molecules/Stepper.tsx",
    "./Tag": "./molecules/Tag.tsx",
    "./ThemeCycleButton": "./molecules/ThemeCycleButton.tsx",
    "./TitledBlock": "./molecules/TitledBlock.tsx",
    "./Toast": "./molecules/Toast.tsx",
    "./ActionBar": "./organisms/ActionBar.tsx",
    "./DataTable": "./organisms/DataTable.tsx",
    "./Dialog": "./organisms/Dialog.tsx",
    "./ListSection": "./organisms/ListSection.tsx",
    "./MultipleChoiceQuestion": "./organisms/MultipleChoiceQuestion.tsx",
    "./Pane": "./organisms/Pane.tsx",
    "./ReorderableList": "./organisms/ReorderableList.tsx",
    "./SidePanel": "./organisms/SidePanel.tsx",
    "./Tabs": "./organisms/Tabs.tsx",
    "./design-system.css": "./styles/design-system.css",
    "./tokens.css": "./styles/tokens.css",
    "./FontLoader": "./fonts/FontLoader.ts",
    "./Spacing": "./constants/Spacing.ts",
    "./Dismissal": "./utils/Dismissal.ts",
    "./ReorderIndexUtil": "./utils/ReorderIndexUtil.ts",
    "./RovingFocusUtil": "./utils/RovingFocusUtil.ts",
    "./ThemeCycleUtil": "./utils/ThemeCycleUtil.ts"
  },
  "peerDependencies": {
    "react": ">=19"
  }
}

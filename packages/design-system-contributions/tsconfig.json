{
  // The package's own project, standing alone as the design-system package's does: DOM library, React's JSX and no Bun or Node types, so
  // a module reaching for `Bun.file` or `node:fs` fails to compile.
  "compilerOptions": {
    "noEmit": true,
    "incremental": true,
    "tsBuildInfoFile": "../../node_modules/.cache/typecheck/design-system-contributions.tsbuildinfo",
    "target": "ESNext",
    "lib": ["ESNext", "DOM", "DOM.Iterable"],
    "module": "Preserve",
    "moduleResolution": "bundler",
    "moduleDetection": "force",
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "jsx": "react-jsx",
    "types": [],
    // The design-system package is linked with `bun link`: resolve from the link, not its real folder, so its React is this one.
    "preserveSymlinks": true,

    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "noFallthroughCasesInSwitch": true,
    "noPropertyAccessFromIndexSignature": true,
    "exactOptionalPropertyTypes": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "forceConsistentCasingInFileNames": true,

    "skipLibCheck": true
  },
  "include": ["./**/*.ts", "./**/*.tsx"],
  // The specs, the DOM specs, the stories and the test-only helpers stay out, so this program's surface is the package that ships.
  "exclude": ["./**/*.spec.ts", "./**/*.dom.tsx", "./**/*.stories.tsx", "./testing/**"]
}

{
  "name": "monorepo-scripts",
  "private": true,
  "description": "The workspace root's own scripts, typechecked, linted and tested through turbo like every other workspace",
  "type": "module",
  "engines": { "bun": "1.4.2" },
  "scripts": {
    "typecheck": "tsc -p tsconfig.json",
    "lint": "eslint . --cache --cache-strategy content --cache-location node_modules/.cache/lint/",
    "lint:fix": "eslint . --cache --cache-strategy content --cache-location node_modules/.cache/lint/ --fix",
    "test": "bun test"
  }
}

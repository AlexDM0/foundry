{
  "version": 3,
  "prepare": [
    {
      "name": "install",
      "run": "bun install --frozen-lockfile",
      "in": "/"
    },
    {
      "name": "generate",
      "run": "bun run generate",
      "in": "packages/example"
    }
  ],
  "gates": [
    {
      "name": "types",
      "run": "bun run typecheck",
      "in": "/apps/example",
      "definedBy": [
        "tsconfig.json"
      ]
    },
    {
      "name": "lint",
      "run": "bun run lint",
      "fix": "bun run lint --fix",
      "in": "packages/example",
      "network": [
        "registry.example.com"
      ],
      "writes": [
        "~/.cache/example"
      ],
      "overseerOnly": true
    }
  ],
  "phases": {
    "build": [
      "types",
      "lint"
    ],
    "review": [
      "types"
    ],
    "merge": [
      "lint",
      "types"
    ]
  },
  "review": {
    "name": "review",
    "reReview": {
      "thresholdLines": 750
    }
  },
  "airlock": {
    "reReview": {
      "thresholdLines": 300
    }
  },
  "constitution": {
    "path": "CONSTITUTION.md"
  },
  "agents": {
    "productOwner": {
      "model": "sonnet",
      "effort": "low"
    },
    "builder": {
      "instructions": [
        {
          "kind": "constitution"
        },
        {
          "kind": "default-brief",
          "role": "builder"
        },
        {
          "kind": "file",
          "path": "docs/example-builder.md"
        }
      ]
    },
    "reviewer": {
      "model": "fable",
      "effort": "xhigh",
      "instructions": []
    },
    "reReviewer": {
      "instructions": [
        {
          "kind": "file",
          "path": ".forge/briefs/example-re-review.md"
        }
      ]
    }
  },
  "approvals": {
    "tickets": false,
    "merge": true
  },
  "billing": {
    "mode": "api",
    "maxBudgetUsd": 2.5
  },
  "reach": [
    "/packages/shared",
    "/bun.lock"
  ]
}

  "extends": "../page/tsconfig.spec.json",
  "compilerOptions": { "tsBuildInfoFile": "../node_modules/.cache/typecheck/architecture.tsbuildinfo" },
  "include": ["./**/*.ts"],
  "exclude": []
}

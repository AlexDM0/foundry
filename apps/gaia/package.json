{
  "name": "gaia",
  "version": "0.1.0",
  "description": "One window over every forge on a machine: what waits on User, every running agent, and every forge's state and controls",
  "type": "module",
  "private": true,
  "engines": { "bun": "1.4.2" },
  "bin": { "gaia": "src/Main.ts" },
  "files": ["src", "page", "resources", "tsconfig.json"],
  "scripts": {
    "typecheck": "bun run --parallel typecheck:root typecheck:page typecheck:page-specs",
    "typecheck:root": "tsc -p tsconfig.json",
    "typecheck:page": "tsc -p page/tsconfig.json",
    "typecheck:page-specs": "tsc -p page/tsconfig.spec.json",
    "lint": "eslint . --cache --cache-strategy content --cache-location node_modules/.cache/lint/",
    "lint:fix": "eslint . --cache --cache-strategy content --cache-location node_modules/.cache/lint/ --fix",
    "test": "bun test",
    "test:dom": "bun page/testing/RunDomSpecs.ts",
    "record": "bun src/testing/RecordBoundary.ts",
    "versions:raise-minimum": "bun src/testing/RaiseGaiaMinimum.ts",
    "check": "bun src/testing/CheckRecordingStamps.ts && bun src/testing/CheckSupportedForgeVersion.ts",
    "verify": "bun run typecheck && bun run lint && bun test && bun run test:dom && bun run check"
  },
  "dependencies": {
    "brand": "workspace:^",
    "design-system": "workspace:^",
    "flint": "workspace:^",
    "forge-contracts": "workspace:^",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "system-versions": "workspace:^"
  }
}

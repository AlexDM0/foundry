{
  // The page program plus Bun types, so the specs and the board's DOM specs (`.dom.tsx`) beside the modules compile; the DOM-only program
  // above stays the proof.
  "extends": "./tsconfig.json",
  "compilerOptions": { "types": ["bun"], "tsBuildInfoFile": "../node_modules/.cache/typecheck/page-specs.tsbuildinfo" },
  "exclude": ["./lib/**"]
}

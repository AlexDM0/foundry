{
  // DOM library and React's JSX, no Bun or Node types: a page module reaching for `Bun.file` or `node:fs` fails to compile.
  "extends": "../tsconfig.json",
  "compilerOptions": {
    "lib": ["ESNext", "DOM", "DOM.Iterable"],
    "jsx": "react-jsx",
    "types": [],
    "tsBuildInfoFile": "../node_modules/.cache/typecheck/page.tsbuildinfo"
  },
  // The page's own modules plus exactly the shared files it may reach, named one by one.
  "include": [
    "./**/*.ts",
    "./**/*.tsx",
    "../src/lib/api-paths/ApiPathUtil.ts",
    "../src/shared/constants/ContractVersions.ts",
    "../src/shared/constants/GaiaSystemVersions.ts",
    "../src/shared/constants/Limits.ts",
    "../src/shared/constants/ProductNames.ts",
    "../src/shared/utils/ContractVersionUtil.ts",
    "../src/shared/utils/SystemVersionUtil.ts"
  ],
  "exclude": ["./**/*.spec.ts", "./**/*.spec.tsx", "./testing/**"]
}
